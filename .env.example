# Copia este archivo como .env antes de ejecutar docker compose (cp .env.example .env).
# Fecha "de hoy" del SAP simulado (las órdenes del piloto van de oct a dic de 2026).
FECHA_REFERENCIA=2026-10-28
# Umbral de confianza del router. Vacío = el que se eligió al entrenar (config_cab.json).
UMBRAL_CONFIANZA=
# Hilos de CPU para el modelo de lenguaje.
HILOS_CPU=2
# Orígenes permitidos para llamar a la API desde otro dominio (CORS).
CORS_ORIGENES=http://localhost:8080,http://127.0.0.1:8080
# Bitácora en formato JSON (una línea por conversación).
BITACORA_RUTA=/app/bitacora/conversaciones.jsonl
